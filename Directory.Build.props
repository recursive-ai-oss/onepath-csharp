<Project>

  <!-- Package naming: the one place the package-ID prefix lives. -->
  <PropertyGroup>
    <PackagePrefix>RecursiveAI</PackagePrefix>
    <!-- The one place the package version lives. A package may not be stable while it depends on a prerelease. -->
    <Version>1.0.0-rc.1</Version>
    <Authors>Recursive AI, LLC</Authors>
    <Company>Recursive AI, LLC</Company>
    <Copyright>Copyright © Recursive AI, LLC</Copyright>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/recursive-ai-oss/onepath-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://recursiveai.org/onepath/</PackageProjectUrl>
    <!-- Source Link ships in the SDK; it only adds repository metadata to the package, no runtime dependency. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!--
    Build output (bin, obj, packages) goes outside the working tree: $(ONEPATH_ARTIFACTS) when set,
    otherwise a per-checkout folder under the user's temp directory.
  -->
  <PropertyGroup>
    <OnePathCheckoutName>$([System.IO.Path]::GetFileName($(MSBuildThisFileDirectory.TrimEnd('/\'))))</OnePathCheckoutName>
    <OnePathArtifactsRoot>$(ONEPATH_ARTIFACTS)</OnePathArtifactsRoot>
    <OnePathArtifactsRoot Condition="'$(OnePathArtifactsRoot)' == ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'onepath-artifacts', $(OnePathCheckoutName)))</OnePathArtifactsRoot>
    <ArtifactsPath>$(OnePathArtifactsRoot)</ArtifactsPath>
  </PropertyGroup>

  <!-- Configurations. Checked = optimized code with the CHECKED symbol: unsafe accessors become bounds-checked. -->
  <PropertyGroup>
    <Configurations>Debug;Release;Checked</Configurations>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Checked'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DefineConstants>$(DefineConstants);CHECKED</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Deterministic source paths in the shipped binaries; src/ only, because tests use [CallerFilePath]. -->
    <_ProjectDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)'))</_ProjectDir>
    <_SrcDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'src'))</_SrcDir>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' and $(_ProjectDir.StartsWith('$(_SrcDir)'))">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Floating-point results must not depend on the machine: no unchecked fast-math style options exist in .NET, keep it that way. -->
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
  </PropertyGroup>

  <!--
    The RecursiveAI.OneMath package comes from a local feed until it is published. Point ONEMATH_FEED at
    the feed folder (an environment variable; nothing machine-specific is tracked).
  -->
  <PropertyGroup Condition="'$(ONEMATH_FEED)' != ''">
    <RestoreAdditionalProjectSources>$(ONEMATH_FEED)</RestoreAdditionalProjectSources>
  </PropertyGroup>

</Project>
