<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>RecursiveAI.OnePath.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <!-- The README snippets are checked against the quickstart tests. -->
    <EmbeddedResource Include="../../README.md" LogicalName="README.md" />
    <EmbeddedResource Include="ReadmeQuickstartTests.cs" LogicalName="ReadmeQuickstartTests.cs" />
    <ProjectReference Include="../../src/OnePath/OnePath.csproj" />
    <!-- The scenario layouts are shared with the hash-matrix runner. -->
    <Compile Include="../../tools/HashMatrix/Scenarios/Orca/OrcaWorlds.cs" Link="Support/OrcaWorlds.cs" />
    <Compile Include="../../tools/HashMatrix/Scenarios/Grids/StateWorlds.cs" Link="Support/StateWorlds.cs" />
    <Compile Include="../../tools/HashMatrix/Scenarios/NavMesh/NavMeshWorlds.cs" Link="Support/NavMeshWorlds.cs" />
    <Compile Include="../../tools/HashMatrix/Scenarios/NavMesh/NavMeshMutations.cs" Link="Support/NavMeshMutations.cs" />
    <Compile Include="../../tools/HashMatrix/Scenarios/Crowds/CorridorWorlds.cs" Link="Support/CorridorWorlds.cs" />
    <Compile Include="../../tools/HashMatrix/Scenarios/Crowds/CrowdWorlds.cs" Link="Support/CrowdWorlds.cs" />
  </ItemGroup>
</Project>
