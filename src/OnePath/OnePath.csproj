<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>$(PackagePrefix).OnePath</PackageId>
    <AssemblyName>$(PackagePrefix).OnePath</AssemblyName>
    <RootNamespace>$(PackagePrefix).OnePath</RootNamespace>
    <Description>Deterministic pathfinding and navigation for .NET: square, hex and voxel grids (A*, JPS, Theta*, HPA*, D* Lite, flow fields), graphs, tiled navigation meshes with 2D and 3D builders and queries, and ORCA crowds. Bit-identical results on every platform.</Description>
    <PackageTags>pathfinding;navigation;navmesh;nav-mesh;astar;a-star;jps;jump-point-search;theta-star;hpa-star;flow-field;crowd;orca;rvo;recast;detour;recast-alternative;voxel;gamedev;deterministic;lockstep;nativeaot</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!-- A pack fails on a breaking change against the last published version. -->
    <PackageValidationBaselineVersion>0.4.0-preview.1</PackageValidationBaselineVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- The library uses its own preview types internally; the diagnostic is for callers. -->
    <NoWarn>$(NoWarn);ONEPATH0002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bar runner and the micro-benchmarks time the specialised searches directly. -->
    <InternalsVisibleTo Include="OnePath.Bar" />
    <InternalsVisibleTo Include="Micro" />
    <InternalsVisibleTo Include="OnePath.Tests" />
    <InternalsVisibleTo Include="GridOptima" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../PACKAGE.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE-APACHE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <!-- The one runtime dependency. Until it is published it restores from the folder in ONEMATH_FEED. -->
    <PackageReference Include="RecursiveAI.OneMath" />
  </ItemGroup>

</Project>
