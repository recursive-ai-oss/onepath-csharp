<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>$(PackagePrefix).OnePath</PackageId>
    <AssemblyName>$(PackagePrefix).OnePath</AssemblyName>
    <RootNamespace>$(PackagePrefix).OnePath</RootNamespace>
    <Description>Deterministic pathfinding and navigation: grids, graphs, navmeshes and crowds.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The bar runner and the micro-benchmarks time the specialised searches directly. -->
    <InternalsVisibleTo Include="OnePath.Bar" />
    <InternalsVisibleTo Include="Micro" />
    <InternalsVisibleTo Include="OnePath.Tests" />
    <InternalsVisibleTo Include="GridOptima" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- The one runtime dependency. Until it is published it restores from the folder in ONEMATH_FEED. -->
    <PackageReference Include="RecursiveAI.OneMath" />
  </ItemGroup>

</Project>
